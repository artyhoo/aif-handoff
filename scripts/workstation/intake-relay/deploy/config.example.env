# Intake relay configuration (plan p2-wake-on-work, B10).
#
# EXAMPLE — PLACEHOLDERS ONLY. Copy to config.env on the bridge and fill in
# owner-approved values through existing routes. NEVER commit a real host
# value, token, or principal identifier: they live only in owner-installed
# files outside the repository (0600, service-user readable).
#
# Fail-closed defaults: mode=retain-only (no endpoint, no delivery, no wake);
# the writer credential path is REQUIRED in every mode — the relay never runs
# an unauthenticated writer (§9.2/R3-S1).

# --- Identity of this relay instance -------------------------------------
AIF_INTAKE_RELAY_MODE=retain-only

# --- Storage / IPC paths --------------------------------------------------
AIF_INTAKE_RELAY_SPOOL_DIR=<state-dir>/aif-intake-relay/spool
AIF_INTAKE_RELAY_SOCKET_PATH=<state-dir>/aif-intake-relay/relay.sock
AIF_INTAKE_RELAY_FENCE_PATH=<state-dir>/aif-intake-relay/fence.active

# --- Mandatory writer authentication (every mode, §9.2/R3-S1) -------------
# High-entropy per-instance secret, owner-installed, 0600, outside the repo.
AIF_INTAKE_RELAY_WRITER_CREDENTIAL_PATH=<secrets-dir>/writer-credential
# Operator-owned fingerprint → principal map (see principals.example.json).
AIF_INTAKE_RELAY_PRINCIPALS_PATH=<secrets-dir>/principals.json

# --- principal₁ resolution (R1) -------------------------------------------
# Preferred: sshd ExposeAuthInfo writes the presented-key identity file
# (`publickey <algorithm> <base64-key-blob>`; the shim derives the SHA256
# fingerprint the stock utility reports from those bytes) and exports its
# path as SSH_USER_AUTH to the forced command. Leave empty to rely on
# SSH_USER_AUTH; the forced-command wrapper should always set this seam to
# the real per-session path.
AIF_INTAKE_RELAY_SSH_AUTH_INFO_PATH=
# Documented fallback with a weaker trust basis: the NAME of a per-key
# authorized_keys `environment=` variable whose value is a principalId.
# Requires sshd `PermitUserEnvironment` on the bridge — as the scoped PATTERN
# LIST naming that variable (e.g. `PermitUserEnvironment AIF_RELAY_PRINCIPAL`),
# NEVER the global yes (which would let every accepted client request
# environment variables; see deploy/ssh-forced-command.example). Empty
# disables it.
AIF_INTAKE_RELAY_PRINCIPAL_ENV_VAR=

# --- Bounds and budgets ---------------------------------------------------
AIF_INTAKE_RELAY_MAX_ENVELOPES=1000
# Byte bound for the spool, enforced against the ACTUAL serialized durable
# records (metadata + receipts) including preserved quarantine bytes (R4).
AIF_INTAKE_RELAY_MAX_BYTES=52428800
# NOTE (R4 wiring inspection): this value is loaded and validated but NOT an
# enforcement point — the effective per-request bound is the per-principal
# `maxRequestBytes` in principals.json, enforced at seal time, at the writer,
# and incrementally on the submit shim's stdin. Set realistic per-principal
# bounds there; do not rely on this knob as a request limit.
AIF_INTAKE_RELAY_DEFAULT_MAX_REQUEST_BYTES=524288
AIF_INTAKE_RELAY_INTAKE_COMPAT_LEVEL=1
AIF_INTAKE_RELAY_CYCLE_MS=5000
AIF_INTAKE_RELAY_RETRY_MAX=5
AIF_INTAKE_RELAY_RETRY_BACKOFF_MS=2000
AIF_INTAKE_RELAY_WAKE_MAX_REPEATS=3
AIF_INTAKE_RELAY_WAKE_BACKOFF_MS=30000
AIF_INTAKE_RELAY_WAKE_WINDOW_MS=60000
AIF_INTAKE_RELAY_HANDOVER_POLL_MAX=20
AIF_INTAKE_RELAY_HANDOVER_POLL_BACKOFF_MS=2000

# --- Deliver mode ONLY (validated when MODE=deliver) ----------------------
# PC-local reverse-forward URL (D1b; never a LAN/tailnet API route).
AIF_INTAKE_RELAY_ENDPOINT=http://127.0.0.1:<forward-port>
# Relay service participant session token (cookie transport — participantAuth
# resolves sessions from the session cookie, not Bearer). Owner-installed 0600.
AIF_INTAKE_RELAY_SESSION_TOKEN_PATH=<secrets-dir>/session-token
# Session-bound CSRF token for POST /tasks (x-csrf-token). Owner-installed 0600.
AIF_INTAKE_RELAY_CSRF_TOKEN_PATH=<secrets-dir>/session-csrf-token
AIF_INTAKE_RELAY_SESSION_COOKIE_NAME=aif_participant_session
# Allowed Origin for the API CSRF check (must be in PARTICIPANT_ALLOWED_ORIGINS).
AIF_INTAKE_RELAY_ORIGIN=http://localhost:<ui-port>
# Always-on wake command (bounded repeats/backoff; deliver mode only).
AIF_INTAKE_RELAY_WAKE_COMMAND=
